# Copy this file to .env and fill in your values. Do not commit .env.
# cp .env.example .env

# ---------------------------------------------------------------------------
# AWS Bedrock (default) — LLM is called via Bedrock, not an "API key"
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
# Claude on Bedrock, e.g. anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Optional: use OpenAI instead of Bedrock
# VANNA_LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-openai-api-key-here

# Optional: use Anthropic direct API
# VANNA_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your-anthropic-key

# Optional: override paths
# VANNA_SQLITE_PATH=/path/to/morning_blotter.db
# VANNA_CHROMADB_PATH=/path/to/vanna_chroma
