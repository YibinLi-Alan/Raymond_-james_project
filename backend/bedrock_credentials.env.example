# Copy to bedrock_credentials.env and fill in. Do not commit bedrock_credentials.env.
# cp backend/bedrock_credentials.env.example backend/bedrock_credentials.env

AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1
# Must use inference profile ID (not raw model ID). us-east-1: us.anthropic...
BEDROCK_MODEL_ID=us.anthropic.claude-3-5-sonnet-20241022-v2:0
